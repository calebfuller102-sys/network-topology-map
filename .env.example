# Host loopback port exposed by the web gateway.
APP_PORT=8080

# The API container uses the fixed persistent path from compose.yaml.
# DATABASE_URL=sqlite:////data/topology.db

# Maximum number of monitor checks active at once (1–64, default 8).
MONITOR_CONCURRENCY=8

# Optional; only used with compose.npm-network.yaml for containerized NPM.
# NPM_DOCKER_NETWORK=npm_proxy

# Optional Vite development proxy target. Leave unset for same-origin use.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
